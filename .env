# --- Amazon SES SMTP credentials ---
# Get these from SES Console -> SMTP settings -> Create SMTP credentials
# Note: SMTP username/password are DIFFERENT from your AWS IAM access keys.
SES_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=AKIAY74SXOOB5JXFUKU5
SES_SMTP_PASS=BFEShT6Rr3rbKXpHJW17aEsXrVag3cb4L0+rOjFuPUgc

# Verified "From" address/domain in SES
SES_FROM_EMAIL="Demo App <no-reply@awssesdemo.gamer.gd>"

# The SES Configuration Set that has the SNS event destination attached
# (Bounce + Complaint events). Leave blank if not using one yet -
# but then bounce tracking won't work.
SES_CONFIGURATION_SET=dev-config-set

# --- This app's own settings ---
# Port this server runs on
PORT=3000

# Secret key the Lambda function must send in the Authorization header
# when it calls POST /api/email-events. Generate any random string.
WEBHOOK_API_KEY=0dc858f79a1e41ca5ccf914bbde1d55c485b8fe26cf2441f3fa626cfcb578349
